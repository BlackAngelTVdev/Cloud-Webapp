# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3333
HOST=localhost
LOG_LEVEL=info
# Générer avec : node ace generate:key
APP_KEY=
SESSION_DRIVER=cookie

# ------------------------------------------------------------------
# Base de données
# ------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=je_donne_je_prete

# ------------------------------------------------------------------
# Microsoft Entra ID (MSAL)
# ------------------------------------------------------------------
# App registration > Vue d'ensemble : Application (client) ID
AZURE_CLIENT_ID=
# App registration > Certificats et secrets : valeur du secret client
AZURE_CLIENT_SECRET=
# Directory (tenant) ID, ou le domaine du tenant (ex: monorganisation.onmicrosoft.com)
AZURE_TENANT_ID=

# Optionnel. Si vide, l'URL est reconstruite depuis la requête :
#   <protocole>://<hôte>/auth/microsoft/callback
# Attention : l'URL de redirection doit être déclarée dans l'app registration.
AZURE_REDIRECT_URI=
AZURE_POST_LOGOUT_REDIRECT_URI=
